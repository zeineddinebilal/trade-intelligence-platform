# Google Gen AI SDK Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-carbon

# Database Configuration (Postgres in production; SQLite fallback for quick local dev)
# Example Postgres: postgresql://postgres:postgres@localhost:5432/trade_intel
DATABASE_URL=sqlite:///./trade_intel.db

# Governance & Pipeline Settings
HUMAN_REVIEW_THRESHOLD=70
AUTO_SEED_DEMO=true
ENVIRONMENT=development

# Access control: if set, the whole dashboard + API (except /healthz) requires
# HTTP Basic auth with this password (any username). STRONGLY recommended in production.
DASHBOARD_PASSWORD=
